{
  "name": "uri-highlight",
  "displayName": "URI Highlight",
  "description": "Fetch remote markdown and open local files with range highlight via HTTP",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "*",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {}
}
